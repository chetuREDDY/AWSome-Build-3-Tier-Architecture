import boto3
import json
import time

def handler(event, context):
    ec2 = boto3.client('ec2')
    ssm = boto3.client('ssm')
    secrets = boto3.client('secretsmanager')
    
    # Get instance ID from CloudFormation event
    instance_id = event['ResourceProperties']['InstanceId']
    secret_arn = event['ResourceProperties']['SecretArn']
    rds_endpoint = event['ResourceProperties']['RDSEndpoint']
    
    # Wait for instance to be running
    waiter = ec2.get_waiter('instance_running')
    waiter.wait(InstanceIds=[instance_id])
    
    # Get database credentials from Secrets Manager
    secret = secrets.get_secret_value(SecretId=secret_arn)
    secret_dict = json.loads(secret['SecretString'])
    
    # Create dbinfo.inc content
    dbinfo_content = f"""<?php
    define('DB_SERVER', '{rds_endpoint}');
    define('DB_USERNAME', '{secret_dict["username"]}');
    define('DB_PASSWORD', '{secret_dict["password"]}');
    define('DB_DATABASE', 'rds');
    ?>"""
    
    # Use SSM to create file on EC2
    ssm.send_command(
        InstanceIds=[instance_id],
        DocumentName='AWS-RunShellScript',
        Parameters={
            'commands': [
                f'echo "{dbinfo_content}" > /var/www/inc/dbinfo.inc'
            ]
        }
    )
    
    return {
        'statusCode': 200,
        'body': 'Configuration completed successfully'
    }
